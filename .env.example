# Local development (Exceptional Electrical Supabase on this machine):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SECRET_KEY=<from `supabase status` — never commit>
#   ALLOW_HOSTED_SUPABASE=0
#
# Hosted/production values belong in Vercel (or a private uncommitted env file).
# In development, hosted Supabase is blocked unless ALLOW_HOSTED_SUPABASE=1.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
ALLOW_HOSTED_SUPABASE=0
# Set to the approved recipient for incoming enquiry notifications in a later milestone.
