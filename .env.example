# Local development (Exceptional Electrical Supabase on this machine):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SECRET_KEY=<from `supabase status` — never commit>
#   ALLOW_HOSTED_SUPABASE=0
#
# Hosted/production values belong in Vercel (or a private uncommitted env file).
# In development, hosted Supabase is blocked unless ALLOW_HOSTED_SUPABASE=1.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
ALLOW_HOSTED_SUPABASE=0
# Optional canonical HQ origin used as an extra allowlisted password-reset redirect
# and as HQ_ORIGIN for the Vapi Edge Function push callback.
# Example Preview: https://exceptional-electrical-v2-git-fe-ed8d9f-bbdhicks-5600s-projects.vercel.app
# NEXT_PUBLIC_HQ_ORIGIN=

# HQ Web Push (opt-in enquiry alerts on installed HQ PWA). Keep HQ_PUSH_ENABLED=0 on Preview
# while Preview and Production share the same Supabase project.
# HQ_PUSH_ENABLED=0
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# Shared secret: Edge Function receive-vapi-enquiry → POST /api/internal/hq-push/enquiry
# HQ_PUSH_INTERNAL_SECRET=
# Hosted Edge Function only (name documented; value in Supabase secrets):
# VAPI_WEBHOOK_SECRET=
